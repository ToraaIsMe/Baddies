			if not sendRequestFlag then
				sendRequestFlag = lower == "add"

				if not sendRequestFlag then
					sendRequestFlag = lower == "1"

					if not sendRequestFlag then
						sendRequestFlag = lower == "2"
					end
				end
			end

			if sendRequestFlag then
				task.delay(0.2, function()
					local sendRequestFlag = false
					local iterator, state, control = ipairs(vs)
					local flag
					repeat
						local controlResult

						control, controlResult = iterator(state, control)

						if not control then
							flag = true
						end

						if flag then
							break
						end
					until item.Name:lower() == controlResult:lower() or item == playerGuiContainer
					if not flag then
						sendRequestFlag = true
					end
					if sendRequestFlag then
						if lower == "s" then
							nestedSendRequest()

							return
						end

						if lower == "add" then
							fallbackSendRequest()

							return
						end

						if lower == "1" then
							task.wait(0.2)
							pcall(function()
								secondaryRemoteFunction:InvokeServer(true)
							end)

							return
						end

						if lower == "2" then
