local function getTokenAmount()
    local trading = PlayerGui:FindFirstChild("Trading")
    local tokenAmount = trading and trading:FindFirstChild("Frame") and trading.Frame:FindFirstChild("Categories") and trading.Frame.Categories:FindFirstChild("TokenAmount")
    local textLabel = tokenAmount and tokenAmount:FindFirstChild("TextLabel")
    if textLabel then
        local match = string.match(textLabel.Text, "%d+")
        if match then return tonumber(match) end
    end
    return 0
end

