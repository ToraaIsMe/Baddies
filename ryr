-- Trade Item Handlers
local function getInventoryItems()
    local data = InventoryClient:Get()
    return data and data.Items or nil
end

local function handleWeaponAndSkinData()
    local nameCounts = {}
    local formattedList = {}
    local dataItems = getInventoryItems()
    local tradableCount, untradableCount = 0, 0
    local secondaryNames = {}

    if dataItems and dataItems.Weapon then
        for _, item in pairs(dataItems.Weapon) do
            if item and item.Name and not IgnoredWeapons[item.Name] then
                local tradable = isTradeLocked(item)
                nameCounts[item.Name] = (nameCounts[item.Name] or 0) + 1
                if tradable then tradableCount = tradableCount + 1 else untradableCount = untradableCount + 1 end
                secondaryNames[item.Name] = secondaryNames[item.Name] or {}
                table.insert(secondaryNames[item.Name], tradable)
                table.insert(formattedList, item.Name .. "::None::" .. tostring(tradable))
            end
        end
    end

    if dataItems and dataItems.WeaponSkin then
        for _, item in pairs(dataItems.WeaponSkin) do
            if item then
                local weapon = item.Weapon or item.WeaponName or item.Type
                local skinName = item.Name
                if weapon and skinName and not ValidFightingStyles[skinName] then
                    table.insert(formattedList, weapon .. "::" .. skinName .. "::" .. tostring(isTradeLocked(item)))
                end
            end
        end
    end

    return nameCounts, formattedList, tradableCount + untradableCount, tradableCount, untradableCount, secondaryNames
end

local function getFallbackWeapons()
    local nameCounts = {}
    local list = {}
    for _, itemKey in ipairs(InventoryClient:FindItems("Weapon")) do
        local item = InventoryClient:GetItem("Weapon", itemKey)
        if item and item.Name and not IgnoredWeapons[item.Name] then
            nameCounts[item.Name] = (nameCounts[item.Name] or 0) + 1
            table.insert(list, item.Name .. "::None")
        end
    end
    return nameCounts, list, 0
end

-- Checks for specific restricted weapons
local function hasRestrictedWeapon(name)
    for _, itemKey in ipairs(InventoryClient:FindItems("WeaponSkin")) do
        local item = InventoryClient:GetItem("WeaponSkin", itemKey)
        if item and item.Name == name then return true end
    end
    for _, itemKey in ipairs(InventoryClient:FindItems("Weapon")) do
        local item = InventoryClient:GetItem("Weapon", itemKey)
        if item and item.Name == name then return true end
    end
    return false
end

local function checkRestrictedWeapons()
    return hasRestrictedWeapon("Spiked Kitty Stanli") or
           hasRestrictedWeapon("Glitter Bomb") or
           hasRestrictedWeapon("Glitter Blue Spray") or
           hasRestrictedWeapon("Love Me Hate Me Taser")
end

